# Copy these values into your host's environment settings (Render → Environment).
# Never commit a real .env file — it is already ignored by .gitignore.

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=f1dff101a2beb0ac4e1e4bc77499cb4fe595a724422bf5cde06cb5b90ac425fdac8ff2cfaf112771cd1c81de483d2a80

# The frontend (GitHub Pages) and the API (Render) are on different sites,
# so cookies must be SameSite=None; Secure. Remove this line if you ever
# serve the frontend from the same domain as the API.
CROSS_SITE_COOKIES=1
